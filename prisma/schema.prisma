generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id                 Int            @id @default(autoincrement())
  title              String
  surugayaUrl        String         @unique
  imageUrl           String?
  managementNumber   String?
  manufacturer       String?
  releaseDate        String?
  listPrice          Int?
  modelNumber        String?
  category           String?
  detailsJson        String?
  latestSalePrice    Int?
  latestBuyPrice     Int?
  salePriceChangedAt DateTime?
  buyPriceChangedAt  DateTime?
  stockStatus        String?
  isTimeSale         Boolean        @default(false)
  previousIsTimeSale Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  histories          PriceHistory[]
  junkHistories      JunkHistory[]
  priceChanges       PriceChange[]

  @@index([updatedAt])
  @@index([title])
  @@index([latestSalePrice])
  @@index([latestBuyPrice])
  @@index([salePriceChangedAt])
  @@index([buyPriceChangedAt])
  @@index([releaseDate])
  @@index([manufacturer])
}

model PriceChange {
  id            Int      @id @default(autoincrement())
  productId     Int
  type          String
  previousPrice Int?
  currentPrice  Int?
  changedAt     DateTime @default(now())
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([changedAt])
  @@index([type, changedAt])
  @@index([productId, changedAt])
}

model JunkHistory {
  id         Int      @id @default(autoincrement())
  productId  Int
  sourceType String   @default("alternate_condition")
  storeName  String?
  condition  String
  price      Int
  checkedAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, checkedAt])
  @@index([productId, sourceType, checkedAt])
  @@index([storeName])
}

model PriceHistory {
  id            Int      @id @default(autoincrement())
  productId     Int
  salePrice     Int?
  buyPrice      Int?
  stockStatus   String?
  isTimeSale    Boolean  @default(false)
  titleSnapshot String?
  checkedAt     DateTime @default(now())
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, checkedAt])
}
