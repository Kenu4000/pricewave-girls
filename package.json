{
  "name": "surugaya-price-tracking",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "predev": "prisma migrate deploy && prisma generate && node --import tsx scripts/backfill-product-conditions.ts && node --import tsx scripts/backfill-product-manufacturers.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --import tsx --test lib/*.test.ts",
    "typecheck": "tsc --noEmit",
    "viewer:export": "node --import tsx scripts/export-viewer-data.ts && node --import tsx scripts/export-viewer-series-data.ts",
    "viewer:publish": "node scripts/publish-viewer.mjs",
    "cleanup:created-products": "node --import tsx scripts/delete-created-products.ts",
    "cleanup:condition-duplicates": "node --import tsx scripts/delete-condition-duplicate-products.ts",
    "crawl:set-after-flatz-7": "node --import tsx scripts/set-crawl-interval-after-brand.ts --after=FLATZ --days=7",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev && prisma generate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "cheerio": "^1.0.0",
    "next": "^16.3.0",
    "playwright": "^1.62.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.8.2",
    "tsx": "^4.23.5",
    "typescript": "^5.8.3"
  }
}
