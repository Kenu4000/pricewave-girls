{
  "manifest_version": 3,
  "name": "駿河屋価格トラッキング 取込",
  "version": "0.12.0",
  "description": "Edgeで表示中の駿河屋商品ページと他ショップ価格をローカルの駿河屋価格トラッキングへ記録し、追跡中商品の価格推移を商品ページへ表示します。",
  "permissions": [
    "activeTab",
    "alarms",
    "scripting",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://suruga-ya.jp/*",
    "https://*.suruga-ya.jp/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://suruga-ya.jp/product/detail/*",
        "https://*.suruga-ya.jp/product/detail/*"
      ],
      "css": ["price-history-panel.css"],
      "js": ["content.js", "price-history-panel.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://localhost:3000/automation/run*",
        "http://127.0.0.1:3000/automation/run*"
      ],
      "js": ["automation-runner.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "駿河屋価格トラッキングへ記録",
    "default_popup": "popup.html"
  }
}
